PROGRAM_START_TO ENTRY@MAIN
FLAG 1/2, FLAG0
FLAG 0/2, FLAG_CASE0
FLAG 0/2, FLAG_CASE1
FLAG 0/2, FLAG_CASE2
FLAG 1/2, FLAG_JMP
FLAG 0/2, FLAG_REV_OPR_ROT
ROUTINE GLOBAL{
ENTRY:
BASE:0
CON0:0
CON1:1743392200
CON2:3486784400
}
ROUTINE MAIN{
ENTRY:
  NEXT FLAG0
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH L_OUTPUT
LABEL0:
  END
L_OUTPUT:
  OUTPUT
  DUP
  REV OUTPUT
  IF FLAG0
  BRANCH LABEL0
  NEXT FLAG0
}

