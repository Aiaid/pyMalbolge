PROGRAM_START_TO ENTRY@MAIN
FLAG 1/2, FLAG0
FLAG 1/2, FLAG1
FLAG 1/2, FLAG2
FLAG 1/2, FLAG3
FLAG 0/2, FLAG_CASE0
FLAG 0/2, FLAG_CASE1
FLAG 0/2, FLAG_CASE2
FLAG 1/2, FLAG_JMP
FLAG 0/2, FLAG_REV_OPR_ROT
ROUTINE GLOBAL{
ENTRY:
BASE:0
CON0:0
CON1:1743392200
CON2:3486784400
OPR_U_H:
  OPR U_H
ROT_U_H:
  NEXT FLAG_REV_OPR_ROT
  ROT
U_H:216
  IF FLAG_REV_OPR_ROT
  BRANCH REV_OPR_U_H
  REV ROT
  SKIP END_REV_U_H
REV_OPR_U_H:
  REV OPR
  NEXT FLAG_REV_OPR_ROT
END_REV_U_H:
  NEXT FLAG1
  IF FLAG0
  BRANCH JMP_BACK0@MAIN
  NEXT FLAG0
  NEXT FLAG1
OPR_U_I:
  OPR U_I
ROT_U_I:
  NEXT FLAG_REV_OPR_ROT
  ROT
U_I:315
  IF FLAG_REV_OPR_ROT
  BRANCH REV_OPR_U_I
  REV ROT
  SKIP END_REV_U_I
REV_OPR_U_I:
  REV OPR
  NEXT FLAG_REV_OPR_ROT
END_REV_U_I:
  NEXT FLAG3
  IF FLAG2
  BRANCH JMP_BACK2@MAIN
  NEXT FLAG2
  NEXT FLAG3
}
ROUTINE MAIN{
ENTRY:
  NEXT FLAG0
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH ROT_U_H@GLOBAL
JMP_BACK0:
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH L_OUTPUT
JMP_BACK1:
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH ROT_U_I@GLOBAL
JMP_BACK2:
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH L_OUTPUT
LABEL0:
  END
L_OUTPUT:
  OUTPUT
  DUP
  REV OUTPUT
  NEXT FLAG2
  IF FLAG1
  BRANCH JMP_BACK1
  NEXT FLAG1
  NEXT FLAG2
  IF FLAG3
  BRANCH LABEL0
  NEXT FLAG3
}

