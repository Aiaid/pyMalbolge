PROGRAM_START_TO ENTRY@MAIN
FLAG 1/2, FLAG0
FLAG 1/2, FLAG1
FLAG 1/2, FLAG2
FLAG 1/2, FLAG3
FLAG 1/2, FLAG4
FLAG 0/2, FLAG_CASE0
FLAG 0/2, FLAG_CASE1
FLAG 0/2, FLAG_CASE2
FLAG 1/2, FLAG_JMP
FLAG 0/2, FLAG_REV_OPR_ROT
FLAG 1/2, REPEAT0_COUNTER0
FLAG 1/2, REPEAT0_COUNTER1
ROUTINE GLOBAL{
ENTRY:
BASE:0
CON0:0
CON1:1743392200
CON2:3486784400
OPR_U_A:
  OPR U_A
ROT_U_A:
  NEXT FLAG_REV_OPR_ROT
  ROT
U_A:195
  IF FLAG_REV_OPR_ROT
  BRANCH REV_OPR_U_A
  REV ROT
  SKIP END_REV_U_A
REV_OPR_U_A:
  REV OPR
  NEXT FLAG_REV_OPR_ROT
END_REV_U_A:
  NEXT FLAG2
  IF FLAG0
  BRANCH JMP_BACK0@MAIN
  NEXT FLAG0
  NEXT FLAG2
}
ROUTINE MAIN{
ENTRY:
  NEXT FLAG0
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH ROT_U_A@GLOBAL
JMP_BACK0:
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH SET_REPEAT0_COUNTER0
JMP_BACK1:
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH SET_REPEAT0_COUNTER1
REPEAT0:
  IF REPEAT0_COUNTER0
  BRANCH REPEAT0_BLOCK_START
  IF REPEAT0_COUNTER1
  BRANCH REPEAT0_BLOCK_START
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH REPEATEND0
REPEAT0_BLOCK_START:
  NEXT FLAG1
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH L_OUTPUT
JMP_BACK2:
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH REPEAT0
REPEATEND0:
REPEAT1:
REPEAT1_BLOCK_START:
  NEXT FLAG4
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH L_OUTPUT
JMP_BACK3:
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH REPEATEND1
  NEXT FLAG_JMP
  IF FLAG_JMP
  BRANCH REPEAT1
REPEATEND1:
  END
L_OUTPUT:
  OUTPUT
  DUP
  REV OUTPUT
  IF FLAG1
  BRANCH JMP_BACK2
  NEXT FLAG1
  IF FLAG4
  BRANCH JMP_BACK3
  NEXT FLAG4
SET_REPEAT0_COUNTER0:
  IF REPEAT0_COUNTER0
  BRANCH SET_REPEAT0_COUNTER0
  NEXT FLAG3
  IF FLAG2
  BRANCH JMP_BACK1
  NEXT FLAG2
  NEXT FLAG3
SET_REPEAT0_COUNTER1:
  IF REPEAT0_COUNTER1
  BRANCH SET_REPEAT0_COUNTER1
  IF FLAG3
  BRANCH REPEAT0
  NEXT FLAG3
}

