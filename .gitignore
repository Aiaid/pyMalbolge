
.vscode/*
*.pyc
__pycache__/
dist/*
build/
*.egg-info/
testpip.md
temp.md

# Local virtualenvs
pyenv/
.venv/
venv/

# Scratch compiler in/out. Anchored to the repo root: unanchored patterns match
# at any depth, which silently excluded test/fixtures/opt/foo.mc -- a fixture
# most of the layout tests read.
/foo.py
/foo.mb
/foo.mg
/foo.mc
/foo.c

# Research notes kept in a private companion repository
docs/research/

# Claude Code per-developer state (settings.json is the shared one)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Reference tools (built locally, not tracked)
ref/LMAO/
ref/LMAO-out/
ref/mbi
ref/nagoya-*/
info

# Claude Design's dc-runtime bundle, re-fetchable with DesignSync. Generated
# artifact of the design tool, not our code; preview.html does not need it.
docs/design/*/support.js

# Web build: npm deps, and vendor/ which build.mjs regenerates (wheel is a
# build artifact; the examples and manifest under it are copies of examples/).
# Deploying runs `node web/build.mjs` first -- see web/README.md.
web/node_modules/
web/vendor/
